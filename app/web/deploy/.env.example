# Example environment for app/web/deploy/compose.yaml. Copy it to .env next to
# compose.yaml and fill in your own values; .env is never committed and the
# Docker build context excludes it. This file contains no credential: every
# value here is a placeholder an operator must replace.
#
# Create the secret files first. Compose file secrets are ordinary bind mounts,
# so the KEK must be a regular file (not a symlink) owned by the container user
# with mode 0600, or `intern-web serve` refuses to start:
#
#   mkdir -p secrets exports
#   # generate the KEK with the same keyset format Intern uses (see
#   # docs/guide/operations.md), then:
#   chown 999:999 secrets/intern_kek && chmod 0600 secrets/intern_kek
#   chmod 0644 secrets/intern_tls_cert
#   chown 999:999 secrets/intern_tls_key && chmod 0600 secrets/intern_tls_key
#   mkdir -p exports && chown 999:999 exports && chmod 0750 exports
#   chown 999:999 secrets/intern_postgres_password && chmod 0600 secrets/intern_postgres_password
#   printf '%s\n' 'postgres://intern:<password>@postgres:5432/intern?sslmode=disable' > secrets/intern_database_url
#   chown 999:999 secrets/intern_database_url && chmod 0600 secrets/intern_database_url

# The MySQL source instance root password (required by the official image).
MYSQL_ROOT_PASSWORD=replace-me
# PostgreSQL control-plane password. It is read by the pinned postgres image;
# the matching URL lives only in INTERN_DATABASE_URL_FILE.
INTERN_POSTGRES_PASSWORD=replace-me

# Pinned images. The defaults are the linux/amd64 digests verified in
# internal/physical/compat.json; change them only together with that matrix.
INTERN_MYSQL_IMAGE=mysql:8.4.11@sha256:85b9bf2e29cf836ecb8c2a15a935d4ba0c606631dff1dd79531a11983c638f2a
INTERN_PXB_IMAGE=percona/percona-xtrabackup:8.4.0-7@sha256:bf1478c188271b2478faddb92a27e8378364b672b8e399c0df1c17fef8cb0ceb

# Image tag being built or used: intern:<INTERN_VERSION>-mysql8.4. Set it to the
# commit or release you are deploying so the upgrade path is visible in
# `docker compose ps`.
INTERN_VERSION=local
# The exact source revision baked into the image and its labels.
INTERN_SOURCE_SHA=unknown
INTERN_LOG_LEVEL=info

# Host port published on 127.0.0.1 for the Intern HTTPS API.
INTERN_HOST_PORT=8443

# Secret files, as absolute or compose-file-relative paths.
INTERN_KEK_FILE_HOST=./secrets/intern_kek
INTERN_TLS_CERT_HOST=./secrets/intern_tls_cert
INTERN_TLS_KEY_HOST=./secrets/intern_tls_key
INTERN_POSTGRES_PASSWORD_FILE=./secrets/intern_postgres_password
INTERN_DATABASE_URL_FILE=./secrets/intern_database_url

# Host directory for restore exports; it must be writable by the container user
# (uid 999) with mode 0750.
INTERN_EXPORT_HOST_DIR=./exports

# Free-space floors in bytes (both must be positive). Budget them for the
# largest chain you keep and the concurrency you allow.
INTERN_MIN_WORK_BYTES=536870912
INTERN_MIN_BACKUP_BYTES=536870912
